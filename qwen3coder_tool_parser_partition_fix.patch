+def test_streaming_last_param_and_close_single_chunk(
+    qwen3_tool_parser, qwen3_tokenizer
+):
+    """Regression: final parameter and function close can share one delta."""
+    request = ChatCompletionRequest(model=MODEL, messages=[])
+
+    deltas = [
+        "<tool_call>",
+        "\n<function=get_current_weather>",
+        "\n",  # triggers json_started -> sends "{"
+        "<parameter=city>\nDallas\n</parameter>",
+        "\n<parameter=state>\nTX\n</parameter>",
+        # A speculative batch can contain the final parameter and all closes.
+        "\n<parameter=unit>\nfahrenheit\n</parameter>"
+        "\n</function>"
+        "\n</tool_call>",
+    ]
+
+    from tests.tool_parsers.utils import (
+        run_tool_extraction_streaming,
+    )
+
+    reconstructor = run_tool_extraction_streaming(
+        qwen3_tool_parser,
+        deltas,
+        request,
+        assert_one_tool_per_delta=False,
+    )
+
+    assert len(reconstructor.tool_calls) == 1
+    args = json.loads(reconstructor.tool_calls[0].function.arguments)
+    assert args == {
+        "city": "Dallas",
+        "state": "TX",
+        "unit": "fahrenheit",
+    }
+
