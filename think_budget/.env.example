# Copy these values into the deployment environment; do not commit the real .env file.
# The standalone reference client requires both URL and key for the selected model.
MG2HG_URL=http://model-host:port/v1
MG2HG_KEY=replace-with-secret

# Used only when the requested model is not listed in naie/models/config.py.
FALLBACK_URL=http://model-host:port/v1
FALLBACK_KEY=replace-with-secret

