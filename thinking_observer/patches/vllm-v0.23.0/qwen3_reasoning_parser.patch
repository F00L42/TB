+@pytest.mark.parametrize("tail", [" different approach.\n", "时间戳。\n", "\n", ""])
+def test_reasoning_terminal_stop_id_preserves_prefix(qwen3_tokenizer, tail):
+    """Stop IDs survive detokenization even when their marker text is stripped."""
+    parser = Qwen3ReasoningParser(qwen3_tokenizer)
+    previous_text = "Let me try a"
+    previous_ids = qwen3_tokenizer.encode(previous_text, add_special_tokens=False)
+    # Deliberately do not tokenize a string containing the end marker.
+    delta_ids = qwen3_tokenizer.encode(tail, add_special_tokens=False) + [
+        parser.end_token_id
+    ]
+    original_ids = list(delta_ids)
+    result = parser.extract_reasoning_streaming(
+        previous_text=previous_text,
+        current_text=previous_text + tail,
+        delta_text=tail,
+        previous_token_ids=previous_ids,
+        current_token_ids=previous_ids + delta_ids,
+        delta_token_ids=delta_ids,
+    )
+    if tail:
+        assert result is not None
+        assert result.reasoning == tail
+        assert result.content is None
+    else:
+        assert result is None
+    assert delta_ids == original_ids
+    assert parser.is_reasoning_end_streaming(previous_ids + delta_ids, delta_ids)
+
+
+def test_reasoning_stripped_nonterminal_end_id_keeps_existing_behavior(
+    qwen3_tokenizer,
+):
+    """An ID in the middle cannot establish a missing marker's text offset."""
+    parser = Qwen3ReasoningParser(qwen3_tokenizer)
+    delta_ids = (
+        qwen3_tokenizer.encode("tail", add_special_tokens=False)
+        + [parser.end_token_id]
+        + qwen3_tokenizer.encode("answer", add_special_tokens=False)
+    )
+    result = parser.extract_reasoning_streaming(
+        previous_text="",
+        current_text="tailanswer",
+        delta_text="tailanswer",
+        previous_token_ids=[],
+        current_token_ids=delta_ids,
+        delta_token_ids=delta_ids,
+    )
+    assert result is None
+
+
+@pytest.mark.parametrize("content", ["", "answer", TOOL_CALL_BODY])
+def test_reasoning_terminal_stop_marker_present(qwen3_tokenizer, content):
+    """Marker-present and speculative content/tool suffixes retain their split."""
+    parser = Qwen3ReasoningParser(qwen3_tokenizer)
+    tail = "reasoning tail"
+    text = tail + parser.end_token + content
+    delta_ids = (
+        qwen3_tokenizer.encode(tail, add_special_tokens=False)
+        + [parser.end_token_id]
+        + qwen3_tokenizer.encode(content, add_special_tokens=False)
+    )
+    result = parser.extract_reasoning_streaming(
+        previous_text="",
+        current_text=text,
+        delta_text=text,
+        previous_token_ids=[],
+        current_token_ids=delta_ids,
+        delta_token_ids=delta_ids,
+    )
+    assert result is not None
+    assert result.reasoning == tail
+    assert result.content == (content or None)
+
+
+@pytest.mark.parametrize("include_marker", [False, True])
+def test_reasoning_terminal_stop_id_delegating(qwen3_tokenizer, include_marker):
+    """The unified parser must publish the tail before marking reasoning ended."""
+    reasoner = Qwen3ReasoningParser(qwen3_tokenizer)
+    parser = DelegatingParser(qwen3_tokenizer)
+    parser.reasoning_parser = reasoner
+    request = ChatCompletionRequest(
+        messages=[], model="test-model", stream=True,
+        stop_token_ids=[reasoner.end_token_id],
+        include_stop_str_in_output=include_marker,
+    )
+    prefix, tail = "Let me try a", " different approach.\n"
+    prefix_ids = qwen3_tokenizer.encode(prefix, add_special_tokens=False)
+    tail_ids = qwen3_tokenizer.encode(tail, add_special_tokens=False) + [
+        reasoner.end_token_id
+    ]
+    messages = [parser.parse_delta(
+        prefix, prefix_ids, request, prompt_token_ids=[], finished=False,
+    ), parser.parse_delta(
+        tail + (reasoner.end_token if include_marker else ""),
+        tail_ids, request, finished=True,
+    )]
+    assert "".join(m.reasoning or "" for m in messages if m) == prefix + tail
+    assert "".join(m.content or "" for m in messages if m) == ""
+    assert parser._stream_state.reasoning_ended
+    assert tail_ids[-1] == reasoner.end_token_id
